# Fail fast if the local Node/pnpm version does not match `engines`.
engine-strict=true

# Hoisted node_modules.
#
# pnpm's default (`isolated`) is stricter and prevents phantom dependencies, and
# that strictness was the original reason for choosing pnpm. React Native's Metro
# bundler does not reliably tolerate the symlinked layout, and a mobile app that
# will not bundle is a worse outcome than a weaker install-time guarantee.
#
# The guarantee is not lost, only moved: `import-x/no-extraneous-dependencies` in
# eslint.config.mjs fails any import of a package the importing workspace does
# not declare. See docs/adr/0008-build-orchestration-and-module-linking.md.
node-linker=hoisted

# Peer deps are installed automatically but a mismatch is a warning, not a build
# break. React Native's ecosystem makes strict peers impractical.
auto-install-peers=true
strict-peer-dependencies=false

# Supply-chain hygiene: refuse packages published in the last 3 days, so a
# compromised release has a window to be caught and unpublished.
minimum-release-age=4320

# Lockfile is authoritative in CI.
prefer-frozen-lockfile=true
