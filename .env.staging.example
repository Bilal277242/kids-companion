# =============================================================================
# APP_ENV=staging — production-shaped, with synthetic data
# =============================================================================
# Staging exists to catch what only appears under production configuration:
# TLS, real provider latency, real payment sandboxes, production framework
# behaviour. It runs NODE_ENV=production for exactly that reason.
#
# What staging must NEVER have is production data. Child voice and transcripts
# cannot be meaningfully anonymised, so they are never copied out of production —
# see PRIVACY.md §11. Staging is seeded with synthetic profiles.
#
# Secrets come from the secret manager. Staging credentials are distinct from
# production credentials; sharing them would make staging a production breach
# surface.
# =============================================================================

APP_ENV=staging
NODE_ENV=production
LOG_LEVEL=info

DATABASE_SSL_MODE=require
REDIS_TLS_ENABLED=true
REDIS_KEY_PREFIX=kc:staging:

CORS_ALLOWED_ORIGINS=https://staging.kidscompanion.app
API_PUBLIC_URL=https://api-staging.kidscompanion.app
API_TRUST_PROXY=true

# Real providers, real models — staging is where latency budgets and cost per
# conversation are measured before they reach a child.
AI_PROVIDER=anthropic
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs
AI_DAILY_COST_CEILING_USD=25

# Safety runs at full strength. A staging environment with weaker safety teaches
# the team that the pipeline is optional.
SAFETY_MODE=strict
SAFETY_INPUT_CLASSIFIER_ENABLED=true
SAFETY_OUTPUT_CLASSIFIER_ENABLED=true
SAFETY_ESCALATION_WEBHOOK_URL=https://alerts.internal.example/staging

# Payment sandboxes, never live keys.
PAYMENTS_ENABLED=true
# No rail is enabled here yet. Adding one requires listing it in
# PAYMENTS_VERIFIED_RAILS as well, and a deployed environment refuses to boot
# otherwise — see docs/PAYMENT_RAILS.md §3.
PAYMENTS_ENABLED_RAILS=
PAYMENTS_VERIFIED_RAILS=
JAZZCASH_MODE=sandbox
EASYPAISA_MODE=sandbox
CARRIER_BILLING_MODE=sandbox
CARD_MODE=sandbox
APPLE_IAP_ENVIRONMENT=sandbox

# Analytics to a separate project, so staging traffic never pollutes product data.
ANALYTICS_ENABLED=true

RETENTION_RAW_AUDIO_DAYS=0
RETENTION_TRANSCRIPT_DAYS=30

# =============================================================================
# Single-host staging (infra/docker/docker-compose.staging.yml)
# =============================================================================
# Only needed when staging runs as containers on one host. A staging
# environment backed by managed Postgres and managed Redis ignores everything
# below and uses DATABASE_URL / REDIS_URL from the secret manager instead.
#
# IMPORTANT — the compose file overrides two values above:
#
#   DATABASE_SSL_MODE=disable     inside the compose network there is no TLS
#   REDIS_TLS_ENABLED=false       terminator in front of either service
#
# That is correct for one host with a private bridge network and WRONG for
# anything reachable off-box. Managed services keep `require`/`true`, which is
# what the values above are set to, and what production enforces at boot.

# Credentials for the containers this compose file starts. Generate them; do not
# reuse a value from any other environment.
POSTGRES_USER=kc_staging
POSTGRES_PASSWORD=
POSTGRES_DB=kids_companion
REDIS_PASSWORD=

# Host ports. The database and Redis are deliberately NOT published.
API_PUBLISH_PORT=8080
WEB_PUBLISH_PORT=3000

# Where the dashboard's SERVER reaches the API. Read at run time, never inlined
# into the browser bundle, so the web image stays environment-agnostic. Inside
# the compose network this is the service name; behind a real load balancer it
# is the internal API address.
API_BASE_URL=http://api:8080

# =============================================================================
# Background worker and readiness
# =============================================================================
# The sweeps are backstops, not the primary path: entitlement is computed from
# timestamps on read, so a subscription expires on time whether or not the sweep
# has run. Minutes, not seconds.
#
# EXACTLY ONE worker instance per environment. There is no distributed lock.
WORKER_PORT=8081
WORKER_SUBSCRIPTION_SWEEP_INTERVAL_MS=300000
WORKER_PAYMENT_RECONCILE_INTERVAL_MS=300000
WORKER_STORE_SYNC_INTERVAL_MS=3600000
WORKER_AUDIO_SWEEP_INTERVAL_MS=900000

# Retry for safety escalations that could not be routed to a human. Much shorter
# than the other sweeps: the others repair a stale number, this one repairs a
# child whose disclosure has not reached anybody yet.
WORKER_ESCALATION_RETRY_INTERVAL_MS=60000

# Rebuilds progress rollups for days whose events are newer than them. The
# backstop for conversations nobody ends — without it a parent sees zeros.
WORKER_LEARNING_ROLLUP_INTERVAL_MS=300000

# Per-dependency deadline for GET /ready. Must stay well under the orchestrator's
# own probe timeout, or a slow dependency becomes a restart loop.
READINESS_PROBE_TIMEOUT_MS=2000
