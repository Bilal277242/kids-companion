# =============================================================================
# APP_ENV=production — the only environment holding real child data
# =============================================================================
# THIS FILE IS A REFERENCE, NOT A DEPLOYMENT ARTEFACT.
#
# No production `.env` file exists anywhere. Every value below is injected at
# runtime from the secret manager. A production configuration committed to a
# file — even without secrets — invites someone to add one later.
#
# The config schema enforces the rules below at boot, and REFUSES TO START if
# any of them is violated. Most importantly: a deploy that accidentally disables
# the safety classifiers will not start. That is intended behaviour, not a
# rough edge. See packages/config/src/env.ts.
# =============================================================================

APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info                        # `trace` is rejected — it risks logging payloads

# --- Enforced at boot in production ---
DATABASE_SSL_MODE=require
REDIS_TLS_ENABLED=true                # must be true
REDIS_KEY_PREFIX=kc:prod:             # must differ from the local prefix
API_TRUST_PROXY=true                  # only because a known load balancer is in front
CORS_ALLOWED_ORIGINS=https://app.kidscompanion.app,https://kidscompanion.app

API_PUBLIC_URL=https://api.kidscompanion.app

# --- Safety: none of these may be disabled ---
SAFETY_MODE=strict
SAFETY_INPUT_CLASSIFIER_ENABLED=true
SAFETY_OUTPUT_CLASSIFIER_ENABLED=true
SAFETY_FAIL_MODE=closed               # `open` is not an accepted value anywhere
SAFETY_REVIEW_QUEUE_ENABLED=true
SAFETY_ESCALATION_WEBHOOK_URL=<from secret manager>   # required — disclosures must reach a human

# --- Providers ---
AI_PROVIDER=anthropic
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs
AI_DAILY_COST_CEILING_USD=500

# --- Retention (PRIVACY.md §8) ---
# 0 = raw child audio is discarded at transcription. Raising this above 0 in
# production ALSO requires RETENTION_RAW_AUDIO_OPT_IN_ACK, or the service will
# not start. See docs/adr/0006-voice-pipeline-and-audio-retention.md.
RETENTION_RAW_AUDIO_DAYS=0
RETENTION_TRANSCRIPT_DAYS=90
RETENTION_ANALYTICS_EVENT_DAYS=395
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_DELETED_ACCOUNT_GRACE_DAYS=30

# --- Payments ---
PAYMENTS_ENABLED=true
PAYMENTS_DEFAULT_CURRENCY=PKR

# WHICH RAILS TAKE REAL MONEY.
#
# Empty, because no rail has been verified. A rail listed in
# PAYMENTS_ENABLED_RAILS but absent from PAYMENTS_VERIFIED_RAILS makes the API
# refuse to start — deliberately. Before adding one, someone must have read the
# provider's current integration documentation AND observed its sandbox: a
# success, a decline, a duplicate callback, and a refund (or confirmation that
# refunds do not exist). See docs/PAYMENT_RAILS.md §3.
PAYMENTS_ENABLED_RAILS=
PAYMENTS_VERIFIED_RAILS=
JAZZCASH_MODE=live
EASYPAISA_MODE=live
CARRIER_BILLING_MODE=live
CARD_MODE=live
APPLE_IAP_ENVIRONMENT=production

# --- Observability ---
METRICS_ENABLED=true
ANALYTICS_ENABLED=true                # per-parent consent still gates every event

# --- All secrets: from the secret manager, never from a file ---
# AUTH_JWT_SECRET, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, REDIS_URL,
# ENCRYPTION_KEY_*, ANTHROPIC_API_KEY, DEEPGRAM_API_KEY, ELEVENLABS_API_KEY,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, JAZZCASH_*, EASYPAISA_*,
# CARRIER_BILLING_*, CARD_*,
# APPLE_IAP_SHARED_SECRET, GOOGLE_PLAY_SERVICE_ACCOUNT_JSON

# --- Background worker ---
# EXACTLY ONE instance. There is no distributed lock, so two workers would query
# every payment rail twice and race on the same rows. Enforce it in the
# orchestrator (replicas: 1), not by convention.
WORKER_PORT=8081
WORKER_SUBSCRIPTION_SWEEP_INTERVAL_MS=300000
WORKER_PAYMENT_RECONCILE_INTERVAL_MS=300000
WORKER_STORE_SYNC_INTERVAL_MS=3600000
WORKER_AUDIO_SWEEP_INTERVAL_MS=900000

# Retry for safety escalations that could not be routed to a human. Much shorter
# than the other sweeps: the others repair a stale number, this one repairs a
# child whose disclosure has not reached anybody yet.
WORKER_ESCALATION_RETRY_INTERVAL_MS=60000

# Rebuilds progress rollups for days whose events are newer than them. The
# backstop for conversations nobody ends — without it a parent sees zeros.
WORKER_LEARNING_ROLLUP_INTERVAL_MS=300000

# --- Readiness ---
# Keep well under the orchestrator's probe timeout, or a slow dependency becomes
# a restart loop instead of a withdrawal from the load balancer.
READINESS_PROBE_TIMEOUT_MS=2000

# -----------------------------------------------------------------------------
# Where an alert goes
# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Without it every alert -- including safety_pipeline,
# the one that means children are talking while the layer checking what reaches
# them is not working -- is a `fatal` log line that something else would have to
# notice. The log line is always written; this is the path a person sees.
#
# TREAT AS A SECRET. A Slack incoming-webhook URL is a bearer credential in path
# form: anyone holding it can post into the channel.
ALERT_WEBHOOK_URL=
# generic = a JSON body, for an Alertmanager receiver or anything in-house.
# slack   = the incoming-webhook `text` shape, which Mattermost also accepts.
ALERT_WEBHOOK_FORMAT=generic
ALERT_WEBHOOK_TIMEOUT_MS=5000
# How often conditions are evaluated. Nothing else drives this: before it
# existed, a deployment with no metrics scraper never evaluated a threshold.
ALERT_EVALUATION_INTERVAL_MS=60000
